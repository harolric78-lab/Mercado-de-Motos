{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/harolric78-lab/Mercado-de-Motos/docs/entrevistas/esquema.json",
  "title": "Entrevistas cualitativas del mercado de motos",
  "description": "Esquema común para usuarios, talleres e importadoras. Los campos sin respuesta se guardan en null o cadena vacía: no se rellenan por inferencia.",
  "type": "object",
  "required": ["tipo_fuente", "entrevistas"],
  "properties": {
    "tipo_fuente": {
      "enum": ["usuarios", "talleres", "importadoras"]
    },
    "total_entrevistas": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "nota": {
      "type": "string"
    },
    "entrevistas": {
      "type": "array",
      "items": { "$ref": "#/$defs/entrevista" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "entrevista": {
      "type": "object",
      "required": ["id", "fecha", "ubicacion", "temas", "observaciones"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(USER|TALLER|IMPORTADORA|ENTREVISTA)_[0-9]{3}$"
        },
        "fecha": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "ubicacion": { "type": "string" },
        "entrevistado": { "type": "string" },
        "cargo": { "type": "string" },
        "consentimiento": {
          "type": ["boolean", "null"],
          "description": "true solo si la persona autoriza el uso de sus respuestas. null cuando no consta."
        },
        "temas": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "perfil": { "$ref": "#/$defs/objeto" },
        "compra": { "$ref": "#/$defs/objeto" },
        "uso": { "$ref": "#/$defs/objeto" },
        "repuestos": { "$ref": "#/$defs/objeto" },
        "opiniones_mercado": { "$ref": "#/$defs/objeto" },
        "satisfaccion": { "$ref": "#/$defs/objeto" },
        "respuestas": { "$ref": "#/$defs/objeto" },
        "preguntas_pendientes": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Datos que faltan y deben confirmarse en campo. Nunca se completan por suposición."
        },
        "observaciones": { "type": "string" },
        "transcripcion": {
          "type": "string",
          "description": "Ruta relativa a la transcripción en data/raw/entrevistas/."
        },
        "audio": {
          "type": "string",
          "description": "Ruta relativa al audio en data/raw/audios/, si existe."
        },
        "audio_sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "texto_original": {
          "type": "string",
          "description": "Transcripción verbatim o respuestas literales. No se corrige ni se resume."
        },
        "transcripcion_automatica": {
          "type": ["boolean", "null"],
          "description": "true si la transcripción proviene de un modelo y no ha sido revisada manualmente."
        },
        "modelo_transcripcion": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": true
    },
    "objeto": {
      "type": ["object", "null"],
      "additionalProperties": true
    }
  }
}
